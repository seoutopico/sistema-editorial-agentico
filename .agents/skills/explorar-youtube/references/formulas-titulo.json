{
  "version": "1.0",
  "nota": "Clasificador de formulas de titulo. HONESTIDAD POR DISEÑO: clasifica las palabras del titulo, no el porque real del exito del video. Que una formula domine entre los videos de interes alto dice que patron verbal se repite en el nicho, no que ese patron cause las visualizaciones (la miniatura, el canal, el tema y el momento pesan tanto o mas). Usalo como mapa de lo que se publica, nunca como receta garantizada.",
  "como_se_aplica": "Antes de comparar, el titulo se pasa a minusculas y se le quitan los acentos; los patrones estan escritos sin acentos y valen para titulos en español y en ingles (los canales del nicho son mixtos). Gana la formula con mas patrones coincidentes; sin ninguna coincidencia, el video queda 'sin clasificar'. En caso de empate gana la primera formula del archivo.",
  "formulas": [
    {
      "id": "la-estadistica",
      "nombre": "La estadística",
      "descripcion": "Un numero concreto en el titular: porcentaje, proporcion o cifra grande que el espectador no conocia.",
      "patrones": [
        "\\d+([.,]\\d+)?\\s?%",
        "\\b\\d+ de cada \\d+\\b",
        "\\b\\d+ (out of|in) \\d+\\b",
        "\\b\\d{1,3}[.,]\\d{3}\\b"
      ]
    },
    {
      "id": "la-lista",
      "nombre": "La lista",
      "descripcion": "Un conjunto contado: N cosas, trucos, errores o herramientas, con el numero en el titular.",
      "patrones": [
        "^\\d+\\s",
        "\\btop\\s?\\d+\\b",
        "\\b\\d+\\s+(cosas|trucos|formas|maneras|errores|herramientas|consejos|claves|razones|pasos|ideas|ejemplos|usos|things|ways|tools|mistakes|tips|reasons|steps|hacks|lessons|examples|uses)\\b"
      ]
    },
    {
      "id": "el-error",
