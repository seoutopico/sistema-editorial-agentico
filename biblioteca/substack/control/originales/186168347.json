ges%2F07444b8d-3c48-47c1-80e0-a499f023bc6e_537x204.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"actions_custom_gpts_chatgpt\" title=\"actions_custom_gpts_chatgpt\" srcset=\"https://substackcdn.com/image/fetch/$s_!Y8-9!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F07444b8d-3c48-47c1-80e0-a499f023bc6e_537x204.png 424w, https://substackcdn.com/image/fetch/$s_!Y8-9!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F07444b8d-3c48-47c1-80e0-a499f023bc6e_537x204.png 848w, https://substackcdn.com/image/fetch/$s_!Y8-9!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F07444b8d-3c48-47c1-80e0-a499f023bc6e_537x204.png 1272w, https://substackcdn.com/image/fetch/$s_!Y8-9!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F07444b8d-3c48-47c1-80e0-a499f023bc6e_537x204.png 1456w\" sizes=\"100vw\" loading=\"lazy\"></picture><div></div></div></div><figcaption class=\"image-caption\">actions custom gpts chatgpt</figcaption></figure></div><h3>La prueba real</h3><p>Le pedí a mi GPT: “Busca contenido sobre niños en info-playas.com”.</p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!MEiL!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!MEiL!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 424w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 848w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 1272w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 1456w\" sizes=\"100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!MEiL!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png\" width=\"612\" height=\"803\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/a655599b-02d7-4786-8bdc-79d860265e15_612x803.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:803,&quot;width&quot;:612,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:46002,&quot;alt&quot;:&quot;Resultado wordpress custom gpts chatgpt&quot;,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://ainalluna.substack.com/i/186168347?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"Resultado wordpress custom gpts chatgpt\" title=\"Resultado wordpress custom gpts chatgpt\" srcset=\"https://substackcdn.com/image/fetch/$s_!MEiL!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 424w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 848w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 1272w, https://substackcdn.com/image/fetch/$s_!MEiL!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa655599b-02d7-4786-8bdc-79d860265e15_612x803.png 1456w\" sizes=\"100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke-width=\"1.5\" stroke=\"var(--color-fg-primary)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\" class=\"icon-noB79L\"><g><path d=\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\"></path></g></svg></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\"><polyline points=\"15 3 21 3 21 9\"></polyline><polyline points=\"9 21 3 21 3 15\"></polyline><line x1=\"21\" x2=\"14\" y1=\"3\" y2=\"10\"></line><line x1=\"3\" x2=\"10\" y1=\"21\" y2=\"14\"></line></svg></button></div></div></div></a><figcaption class=\"image-caption\">Resultado wordpress custom gpts chatgpt</figcaption></figure></div><p></p><p>Ocho posts que había olvidado que existían. Pero lo mejor no es la búsqueda. Es lo que viene después.</p><div class=\"pullquote\"><p>El GPT me pregunta: “¿Qué quieres hacer con este contenido?” Y me ofrece: un resumen, un nuevo artículo SEO basado en ellos, reutilizarlos para redes sociales, o fusionar varios en uno solo.</p></div><p>De una búsqueda, un calendario editorial completo. Del archivo que ya tenía.</p><h3>Lo que necesitas</h3><p>No hace falta saber programar. Solo entender dos cosas:</p><p><strong>1. Tu WordPress ya tiene API</strong></p><p>Prueba esto en tu navegador:</p><p>https://tudominio.com/wp-json/wp/v2/posts</p><p>Si ves un bloque de JSON, ya está funcionando.</p><p><strong>2. El GPT necesita un schema</strong></p><p>Es un archivo que le dice a ChatGPT qué puede pedirle a tu web. Los endpoints, los parámetros, el formato.</p><p>El schema completo está en el bonus. Copia, pega, cambia tu dominio.</p><pre><code> {\n    \"openapi\": \"3.1.0\",\n    \"info\": {\n      \"title\": <strong>\"[PON TU WEB]</strong> API\",\n      \"description\": \"API para acceder a posts de <strong>[PON TU WEB]</strong>\",\n      \"version\": \"1.0.0\"\n    },\n    \"servers\": [\n      {\n      <strong>  \"url\": \"https://tudominio.com/wp-json/wp/v2\"</strong>\n      }\n    ],\n    \"paths\": {\n      \"/posts\": {\n        \"get\": {\n          \"summary\": \"Listar posts\",\n          \"operationId\": \"listPosts\",\n          \"parameters\": [\n            {\n              \"name\": \"per_page\",\n              \"in\": \"query\",\n              \"required\": false,\n              \"schema\": {\n                \"type\": \"integer\",\n                \"default\": 10\n              }\n            },\n            {\n              \"name\": \"page\",\n              \"in\": \"query\",\n              \"required\": false,\n              \"schema\": {\n                \"type\": \"integer\",\n                \"default\": 1\n              }\n            },\n            {\n              \"name\": \"_fields\",\n              \"in\": \"query\",\n              \"required\": false,\n              \"schema\": {\n                \"type\": \"string\",\n                \"default\": \"id,title,slug,excerpt,link\"\n              }\n            }\n          ],\n          \"responses\": {\n            \"200\": {\n              \"description\": \"Lista de posts\"\n            }\n          }\n        }\n      },\n      \"/posts/{id}\": {\n        \"get\": {\n          \"summary\": \"Obtener post por ID\",\n          \"operationId\": \"getPostById\",\n          \"parameters\": [\n            {\n              \"name\": \"id\",\n              \"in\": \"path\",\n              \"required\": true,\n              \"schema\": {\n                \"type\": \"integer\"\n              }\n            },\n            {\n              \"name\": \"_fields\",\n              \"in\": \"query\",\n              \"required\": false,\n              \"schema\": {\n                \"type\": \"string\",\n                \"default\": \"id,title,content,link\"\n              }\n            }\n          ],\n          \"responses\": {\n            \"200\": {\n              \"description\": \"Post completo\"\n            }\n          }\n        }\n      }\n    }\n  }</code></pre><h3>Por qué esto importa</h3><p>La semana pasada hablé de extraer contenido de lo que ya haces. Esta semana lo automatizamos.</p><p>El patrón es el mismo. No inventar. Extraer. Pero ahora con una herramienta que puede leer años de archivo en segundos.</p><p>Volví a mirar esos 847 posts. Ya no son contenido abandonado. Son materia prima para el próximo año de calendario editorial.</p><p>La pregunta no es de qué escribo esta semana. La pregunta es qué tengo que aún no he explotado.</p><p>¿Tienes un WordPress lleno de contenido acumulado? </p><h2>📩 ¿Quieres la guía completa?</h2><p><em><strong>Si quieres el paso a paso con capturas para configurar tu GPT (sin tocar código), déjame un comentario con tu caso de uso y te la envío.</strong></em></p><div class=\"pullquote\"><p>Cuéntamelo. Siempre leo todo.</p></div><p><strong>Fuentes:</strong></p><ul><li><p><a href=\"https://platform.openai.com/docs/actions/introduction\">OpenAI GPT Actions Documentation</a></p></li><li><p><a href=\"https://developer.wordpress.org/rest-api/reference/posts/\">WordPress REST API Reference</a></p></li></ul><div><hr></div><div class=\"captioned-image-container\"><figure><div class=\"image-link image2\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!KYv_!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F67c58daa-610b-4f97-9d9e-c7a7431183ba_80x80.webp 424w, https://substackcdn.com/image/fetch/$s_!KYv_!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F67c58daa-610b-4f97-9d9e-c7a7431183ba_80x80.webp 848w, https://substackcdn.com/image/fetch/$s_!KYv_!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F67c58daa-610b-4f97-9d9e-c7a7431183ba_80x80.webp 1272w, https://substackcdn.com/image/fetch/$s_!KYv_!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F67c5